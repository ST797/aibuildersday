# Local SQLite file, or a Turso URL like libsql://your-db-name-user.turso.io
DATABASE_URL=file:./local.db
# Required for remote Turso databases
DATABASE_AUTH_TOKEN=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Local: http://localhost:3000
# Production: your Vercel URL, e.g. https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Issued by AgenticOrg. Never expose this value to browser code.
AGENTICORG_API_KEY=ao_sk_replace-with-your-key
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
